includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        analyse:
            - tests/ArchTest.php
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: false
            - tests/Pest.php
    peststan:
        testCaseClass: IllumaLaw\HybridSearch\Tests\TestCase
