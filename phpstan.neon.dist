includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        analyse:
            - tests/ArchTest.php
            - tests/Pest.php
            # Larastan currently recurses until stack exhaustion on this Eloquent macro fixture.
            # The test remains covered by the Pest matrix.
            - tests/EloquentMacroTest.php
            # Dynamic Laravel macro closures trigger a Larastan stack overflow in this provider.
            # The registered schema/query macros are exercised by the Pest suite.
            - src/HybridSearchServiceProvider.php
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: false
    peststan:
        testCaseClass: IllumaLaw\HybridSearch\Tests\TestCase
